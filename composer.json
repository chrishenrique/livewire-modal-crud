{
    "name": "chrishenrique/livewire-modal-crud",
    "description": "Livewire Modals Crud easy",
    "keywords": [
        "laravel",
        "livewire",
        "modal",
        "crud",
        "laravel-package",
        "php"
    ],
    "homepage": "https://github.com/chrishenrique16/livewire-modal-crud",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ChrisHenrique\\ModalCrud\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Christiano Costa",
            "email": "chrishenrique16@hotmail.com",
            "homepage": "https://christianocosta.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0",
        "livewire/livewire": "^4.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChrisHenrique\\ModalCrud\\ModalCrudServiceProvider"
            ],
            "aliases": {
                "Modal": "ChrisHenrique\\ModalCrud\\Facades\\Modal"
            }
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisHenrique\\ModalCrud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    }
}
